# Copy only non-secret settings. Production can reuse an existing root-owned
# server-side EnvironmentFile that already provides the two Supabase values.
SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-side-service-role-key

CLAUDE_EXECUTABLE=/home/ubuntu/.local/bin/claude
CLAUDE_DEFAULT_DIRECTORY=/home/ubuntu
BRIDGE_POLL_INTERVAL_MS=15000
BRIDGE_CLAIM_LEASE_SECONDS=60
BRIDGE_MAX_EVENT_CHARS=12000
LOG_LEVEL=info

# Safe defaults for public installations. Only enable both on a trusted, dedicated host.
CLAUDE_PERMISSION_MODE=default
BRIDGE_APPROVAL_POLICY=manual
# For unattended operation on a trusted host:
# CLAUDE_PERMISSION_MODE=bypassPermissions
# BRIDGE_APPROVAL_POLICY=always
